# ============================================================================
# THOTH Production Environment Variables Template
# Copy to .env.prod and fill in actual values
# ============================================================================

# Environment
ENVIRONMENT=prod

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# ECR Registry
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
IMAGE_TAG=latest

# RDS Endpoints (from Terraform outputs)
RDS_USER_ENDPOINT=user-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_DOCUMENT_ENDPOINT=document-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_NOTIFICATION_ENDPOINT=notification-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_QUIZ_ENDPOINT=quiz-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_CHAT_ENDPOINT=chat-db.xxxxx.us-east-1.rds.amazonaws.com

# Database Passwords (stored in AWS Secrets Manager)
USER_DB_PASSWORD=from-secrets-manager
DOCUMENT_DB_PASSWORD=from-secrets-manager
NOTIFICATION_DB_PASSWORD=from-secrets-manager
QUIZ_DB_PASSWORD=from-secrets-manager
CHAT_DB_PASSWORD=from-secrets-manager

# DocumentDB (MongoDB)
DOCUMENTDB_URI=mongodb://admin:password@docdb-cluster.xxxxx.us-east-1.docdb.amazonaws.com:27017

# MSK Kafka
MSK_BOOTSTRAP_SERVERS=b-1.thoth-kafka.xxxxx.kafka.us-east-1.amazonaws.com:9092,b-2.thoth-kafka.xxxxx.kafka.us-east-1.amazonaws.com:9092,b-3.thoth-kafka.xxxxx.kafka.us-east-1.amazonaws.com:9092

# S3 Buckets
S3_DOCUMENTS_BUCKET=thoth-documents-prod
S3_TERRAFORM_STATE=thoth-terraform-state-prod

# Application Load Balancer
ALB_DNS_NAME=https://thoth-alb-xxxxx.us-east-1.elb.amazonaws.com

# AWS SES (Phase 3)
SES_FROM_EMAIL=notifications@thoth.ai
SES_REGION=us-east-1

# AI Service API Keys (stored in AWS Secrets Manager)
GROQ_API_KEY=from-secrets-manager
GROQ_API_KEY_2=from-secrets-manager
GROQ_API_KEY_3=from-secrets-manager
GROQ_API_KEY_4=from-secrets-manager
GROQ_API_KEY_5=from-secrets-manager
GROQ_API_KEY_6=from-secrets-manager
GOOGLE_API_KEY=from-secrets-manager
CHAT_GOOGLE_API_KEY=from-secrets-manager

# Models
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=models/gemini-1.5-pro
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
SPACY_MODEL=en_core_web_sm
NOTES_MAX_CHARS=15000
