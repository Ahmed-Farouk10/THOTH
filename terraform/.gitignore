# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (commit this for consistency)
# .terraform.lock.hcl

# Environment variable files
.env
.env.*
!.env.*.template

# Terraform outputs
.terraform-outputs.json
terraform-outputs.json

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub

# AWS credentials
.aws/
credentials

# Editor directories
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Backup files
*.backup
*.bak

# Local scripts that might contain secrets
*local*.sh
*local*.ps1
