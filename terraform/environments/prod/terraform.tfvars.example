# ==============================================================================
# Terraform Configuration Values for THOTH Production
# ==============================================================================
# TODO: Fill in these values when you have AWS access
# ==============================================================================

# AWS Configuration
aws_region = "us-east-1"
environment = "prod"

# Network Configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# EC2 Swarm Cluster
swarm_manager_count = 3
swarm_worker_count = 6
manager_instance_type = "t3.medium"
worker_instance_type = "t3.large"

# TODO: Replace with your SSH public key
# Generate with: ssh-keygen -t rsa -b 4096
# Then copy content of: cat ~/.ssh/id_rsa.pub
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQ... your-email@example.com"

# RDS Databases
rds_instance_class = "db.t3.medium"
rds_allocated_storage = 100
rds_multi_az = true

# DocumentDB (MongoDB-compatible)
docdb_instance_class = "db.t3.medium"
docdb_cluster_size = 3

# MSK Kafka
msk_instance_type = "kafka.t3.small"
msk_broker_count = 3

# S3 Storage
s3_documents_bucket = "thoth-documents-prod"

# Domain & SSL (Optional - leave empty if you don't have a domain yet)
# TODO: If you have a domain, configure it here
domain_name = ""  # e.g., "thoth.yourdomain.com"
acm_certificate_arn = ""  # e.g., "arn:aws:acm:us-east-1:123456789:certificate/xxx"

# GitHub Repository
# TODO: Replace with your GitHub username and repo name
github_repo = "YOUR_GITHUB_USERNAME/THOTH"
