# ============================================================================
# THOTH Staging Environment Variables Template
# Copy to .env.staging and fill in actual values
# ============================================================================

# Environment
ENVIRONMENT=staging

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# ECR Registry
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
IMAGE_TAG=staging-latest

# RDS Endpoints (smaller instances for staging)
RDS_USER_ENDPOINT=user-db-staging.xxxxx.us-east-1.rds.amazonaws.com
RDS_DOCUMENT_ENDPOINT=document-db-staging.xxxxx.us-east-1.rds.amazonaws.com
RDS_NOTIFICATION_ENDPOINT=notification-db-staging.xxxxx.us-east-1.rds.amazonaws.com
RDS_QUIZ_ENDPOINT=quiz-db-staging.xxxxx.us-east-1.rds.amazonaws.com
RDS_CHAT_ENDPOINT=chat-db-staging.xxxxx.us-east-1.rds.amazonaws.com

# Database Passwords
USER_DB_PASSWORD=from-secrets-manager
DOCUMENT_DB_PASSWORD=from-secrets-manager
NOTIFICATION_DB_PASSWORD=from-secrets-manager
QUIZ_DB_PASSWORD=from-secrets-manager
CHAT_DB_PASSWORD=from-secrets-manager

# DocumentDB
DOCUMENTDB_URI=mongodb://admin:password@docdb-staging.xxxxx.us-east-1.docdb.amazonaws.com:27017

# MSK Kafka (single broker for staging)
MSK_BOOTSTRAP_SERVERS=b-1.thoth-kafka-staging.xxxxx.kafka.us-east-1.amazonaws.com:9092

# S3 Buckets
S3_DOCUMENTS_BUCKET=thoth-documents-staging
S3_TERRAFORM_STATE=thoth-terraform-state-staging

# Application Load Balancer
ALB_DNS_NAME=https://thoth-alb-staging-xxxxx.us-east-1.elb.amazonaws.com

# AWS SES
SES_FROM_EMAIL=notifications-staging@thoth.ai
SES_REGION=us-east-1

# AI Service API Keys
GROQ_API_KEY=from-secrets-manager
GROQ_API_KEY_2=from-secrets-manager
GROQ_API_KEY_3=from-secrets-manager
GROQ_API_KEY_4=from-secrets-manager
GROQ_API_KEY_5=from-secrets-manager
GROQ_API_KEY_6=from-secrets-manager
GOOGLE_API_KEY=from-secrets-manager
CHAT_GOOGLE_API_KEY=from-secrets-manager

# Models
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=models/gemini-1.5-pro
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
SPACY_MODEL=en_core_web_sm
NOTES_MAX_CHARS=15000
